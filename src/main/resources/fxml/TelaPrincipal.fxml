<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane prefHeight="560.0" prefWidth="880.0" styleClass="fundo" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.view.controller.TelaPrincipalController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="12.0" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="titulo" text="Minhas tarefas" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnNovaTarefa" mnemonicParsing="false" onAction="#onNovaTarefa" prefHeight="32.0" styleClass="botao-primario" text="Nova tarefa" />
         </children>
         <padding>
            <Insets bottom="16.0" left="24.0" right="24.0" top="20.0" />
         </padding>
      </HBox>
   </top>
   <center>
      <TableView fx:id="tabelaTarefas" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <columns>
            <TableColumn fx:id="colTitulo" prefWidth="240.0" text="Título" />
            <TableColumn fx:id="colDescricao" prefWidth="340.0" text="Descrição" />
            <TableColumn fx:id="colTipo" prefWidth="130.0" text="Tipo" />
            <TableColumn fx:id="colPrioridade" prefWidth="120.0" text="Prioridade" />
         </columns>
         <BorderPane.margin>
            <Insets left="24.0" right="24.0" />
         </BorderPane.margin>
      </TableView>
   </center>
   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="btnEditar" mnemonicParsing="false" onAction="#onEditar" prefHeight="32.0" prefWidth="90.0" text="Editar" />
            <Button fx:id="btnRemover" mnemonicParsing="false" onAction="#onRemover" prefHeight="32.0" prefWidth="90.0" styleClass="botao-perigo" text="Remover" />
         </children>
         <padding>
            <Insets bottom="20.0" left="24.0" right="24.0" top="16.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>